# --- Supabase (base de datos + almacenamiento de imágenes) ---
# Los sacas en Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administrador ---
# ADMIN_PASSWORD: la contraseña que escribirás para entrar en /admin
# ADMIN_SESSION_SECRET: una cadena larga y aleatoria cualquiera (no la escribes en ningún sitio, solo aquí)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Stripe (pago con tarjeta) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Bizum ---
# El número de teléfono que se le muestra al cliente para pagar por Bizum
BIZUM_TELEFONO=

# --- Correos automáticos (opcional pero recomendado) ---
# Crea una cuenta gratis en resend.com para que se envíen correos de confirmación
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_NOTIFICACIONES=

# --- General ---
# La URL donde esté publicada la tienda (la de Vercel una vez desplegada)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
